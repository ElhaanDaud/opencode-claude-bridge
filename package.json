{
  "name": "opencode-claude-bridge",
  "version": "1.10.12",
  "description": "OpenCode \u2194 Claude bridge \u2014 keychain sync + PKCE OAuth + request transformation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/opencode2/server.d.ts",
      "default": "./dist/opencode2/server.js"
    },
    "./tui": {
      "types": "./dist/opencode2/tui.d.ts",
      "default": "./dist/opencode2/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test $(find dist -name '*.test.js' | sort)",
    "validate:oauth": "npm run build && node scripts/validate-opencode-oauth.js"
  },
  "keywords": [
    "opencode",
    "anthropic",
    "oauth",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dotCipher/opencode-claude-bridge"
  },
  "author": "dotCipher",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "bin": {
    "claude-pool": "./scripts/claude-pool.mjs"
  }
}
